{
  "name": "gs-map-music",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:data": "tsx --test tests/data/*.test.ts && node --test tests/data/*.test.mjs",
    "db:setup": "node scripts/setup-mysql.mjs",
    "db:import": "tsx scripts/import-music-library.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "pinia": "3.0.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/leaflet": "1.9.21",
    "@vitejs/plugin-vue": "6.0.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
